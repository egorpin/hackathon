# Copy to .env to change the client port published on all host interfaces.
MARS_PORT=8000
# Standalone offline HTTPS deployment (compose.https.yaml).
MARS_HTTPS_PORT=8443
# Same-origin LAN addresses are accepted automatically; additional HTTPS origins:
# MARS_HTTPS_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
# For LAN browsers, add each exact http://<server-LAN-IP>:<MARS_PORT> origin.
# MARS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set true only when serving over HTTPS.
MARS_SECURE_COOKIE=false
# Planet benchmark geometry. Each radius/subdivision pair needs its own save directory or Docker volume.
MARS_PLANET_RADIUS=30
MARS_PLANET_SUBDIVISIONS=3
# AI assistant: start tools/start-game-ai.ps1 to connect to Tesla over SSH.
# For Python outside Docker use http://127.0.0.1:11435 instead.
MARS_AI_URL=http://host.docker.internal:11435
MARS_AI_MODEL=qwen3.5:27b-q4_K_M
MARS_AI_CONTEXT=32768

# Admin panel /admin. Optional, at least 24 characters; otherwise generated in DATA_DIR/admin.key.
MARS_ADMIN_TOKEN=
